        /// <summary>
        /// Quotes multipart file names in Content-Disposition headers. Some mock servers
        /// (e.g. Stoplight Prism) cannot parse unquoted file names.
        /// </summary>
        private class QuotedMultipartFilenameHandler : DelegatingHandler
        {
            protected override Task<HttpResponseMessage> SendAsync(HttpRequestMessage request, CancellationToken cancellationToken)
            {
                if (request.Content is MultipartFormDataContent multipartContent)
                {
                    foreach (var content in multipartContent)
                    {
                        var disposition = content.Headers.ContentDisposition;

                        if (disposition?.FileName is string filename)
                        {
                            disposition.FileName = null;
                            disposition.FileNameStar = null;
                            disposition.Parameters.Add(new NameValueHeaderValue("filename", $"\"{filename.Replace("\\", "\\\\").Replace("\"", "\\\"")}\""));
                        }
                    }
                }

                return base.SendAsync(request, cancellationToken);
            }
        }

